# Normalise to LF in the repository; check out native line endings on Windows.
* text=auto

# The Gradle wrapper script is executed by sh on macOS and Linux. CRLF endings
# would make it fail with a bad interpreter error, so pin it to LF regardless of
# the committer's platform. Its Windows counterpart needs CRLF.
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.jar binary
*.png binary
*.webp binary
*.keystore binary
*.jks binary
